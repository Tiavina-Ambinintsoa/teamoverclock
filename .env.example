# Copiez ce fichier en .env.local puis remplissez (ne JAMAIS commiter .env.local).
# Toutes les variables VITE_* sont incluses dans le build => publiques.
# Sans Supabase configuré, l'app tourne en "mode démo local" (données dans le navigateur).

# --- Supabase (Settings > API Keys) -----------------------------------------
VITE_SUPABASE_URL=
# Clé PUBLIABLE (sb_publishable_...). Jamais la clé secrète (sb_secret_... / service_role) ici.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Compte de démonstration pour le jury (bouton "Essayer avec le compte démo") ---
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# --- Déploiement ---------------------------------------------------------------
# Sous-dossier de déploiement (avec / au début et à la fin). Vide = racine.
VITE_BASE=
# true = URLs en /#/route : aucune règle de réécriture serveur nécessaire.
VITE_USE_HASH_ROUTER=false
# true = garde les pages /kit et /modeles accessibles en production (à mettre sur false pour le rendu jury).
VITE_ENABLE_KIT=false
