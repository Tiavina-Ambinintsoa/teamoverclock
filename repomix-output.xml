@import "tailwindcss";
@import "tw-animate-css";
@import "./styles/presets.css";

@custom-variant dark (&:is(.dark *));

/* Les couleurs, rayons et polices viennent des variables des presets (styles/presets.css).
   Utilisez TOUJOURS ces tokens (bg-primary, text-muted-foreground, bg-highlight...), jamais de hex en dur. */
@theme inline {
  --font-sans: var(--font-body);
  --font-display: var(--font-heading);

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-highlight: var(--highlight);
  --color-highlight-foreground: var(--highlight-foreground);
  --color-destructive: var(--destructive);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
}

:root {
  --font-body: "Instrument Sans Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  html {
    color-scheme: light;
    -webkit-text-size-adjust: 100%;
  }
  html.dark {
    color-scheme: dark;
  }
  body {
    @apply bg-background text-foreground font-sans antialiased;
  }
  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-heading);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  p,
  li {
    text-wrap: pretty;
  }
  /* Focus clavier toujours visible (critère d'accessibilité et de finition) */
  :where(a, button, input, textarea, select, summary, [tabindex]):focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
}

/* Un seul moment orchestré : l'entrée du hero (--i = rang dans la séquence). */
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@utility rise {
  animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  animation-delay: calc(var(--i, 0) * 90ms);
}

/* Éclat de particules du LikeButton (components/interactive/like-button.tsx). */
@keyframes like-burst {
  from {
    transform: rotate(var(--angle)) translateX(0) scale(1);
    opacity: 1;
  }
  to {
    transform: rotate(var(--angle)) translateX(15px) scale(0);
    opacity: 0;
  }
}

/* Respect de prefers-reduced-motion (accessibilité + écoconception) */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
