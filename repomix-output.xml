/*
 * THÈMES PRÊTS À L'EMPLOI
 * ------------------------------------------------------------------
 * Chaque preset définit TOUS les tokens (clair + sombre) : n'en supprimez
 * jamais un seul, sinon le preset "hérite" de valeurs d'un autre thème.
 * Choisir un thème : SITE.defaultPreset dans src/lib/site.ts (ou le sélecteur de /kit).
 * Créer le vôtre : dupliquez un bloc, changez data-theme, ajustez ~10 valeurs oklch.
 *
 * Les sélecteurs sont volontairement SANS ":root" pour fonctionner aussi sur un
 * conteneur (aperçus de la page /kit).
 */

/* ===== LAGON — océan Indien : turquoise + corail (défaut) ===== */
:root,
[data-theme="lagon"] {
  --font-heading: "Bricolage Grotesque Variable", ui-sans-serif, system-ui, sans-serif;
  --radius: 0.875rem;
  --background: oklch(0.985 0.006 205);
  --foreground: oklch(0.24 0.045 235);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.24 0.045 235);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.24 0.045 235);
  --primary: oklch(0.48 0.1 205);
  --primary-foreground: oklch(0.99 0.004 205);
  --secondary: oklch(0.955 0.02 205);
  --secondary-foreground: oklch(0.3 0.05 235);
  --muted: oklch(0.96 0.01 210);
  --muted-foreground: oklch(0.48 0.03 230);
  --accent: oklch(0.945 0.03 200);
  --accent-foreground: oklch(0.3 0.06 225);
  --highlight: oklch(0.74 0.15 38);
  --highlight-foreground: oklch(0.24 0.06 30);
  --destructive: oklch(0.55 0.22 27);
  --border: oklch(0.905 0.014 210);
  --input: oklch(0.88 0.018 210);
  --ring: oklch(0.6 0.1 205);
  --chart-1: oklch(0.55 0.11 205);
  --chart-2: oklch(0.72 0.15 38);
  --chart-3: oklch(0.4 0.06 240);
  --chart-4: oklch(0.8 0.09 90);
  --chart-5: oklch(0.6 0.12 150);
}
.dark,
[data-theme="lagon"].dark,
.dark [data-theme="lagon"] {
  --background: oklch(0.19 0.035 235);
  --foreground: oklch(0.965 0.01 205);
  --card: oklch(0.23 0.04 235);
  --card-foreground: oklch(0.965 0.01 205);
  --popover: oklch(0.23 0.04 235);
  --popover-foreground: oklch(0.965 0.01 205);
  --primary: oklch(0.79 0.11 195);
  --primary-foreground: oklch(0.2 0.04 235);
  --secondary: oklch(0.29 0.04 235);
  --secondary-foreground: oklch(0.95 0.015 205);
  --muted: oklch(0.27 0.035 235);
  --muted-foreground: oklch(0.73 0.03 215);
  --accent: oklch(0.31 0.05 225);
  --accent-foreground: oklch(0.96 0.012 205);
  --highlight: oklch(0.77 0.14 42);
  --highlight-foreground: oklch(0.22 0.05 30);
  --destructive: oklch(0.7 0.19 22);
  --border: oklch(1 0 0 / 12%);
  --input: oklch(1 0 0 / 16%);
  --ring: oklch(0.72 0.1 195);
  --chart-1: oklch(0.79 0.11 195);
